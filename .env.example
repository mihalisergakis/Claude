# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated emails allowed to sign in
ALLOWED_EMAILS=you@example.com

# Claude API
ANTHROPIC_API_KEY=
# Optional per-step model overrides (default: claude-opus-5-5)
# MODEL_DISCOVERY=claude-opus-5-5
# MODEL_RESEARCH=claude-opus-5-5
# MODEL_QUALIFY=claude-opus-5-5

# Shared secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# Public URL of the app (used in magic-link redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
